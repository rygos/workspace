{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimale Desktop-Berechtigungen für lokale Einstellungen und den konfigurierten KI-Endpunkt.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "store:default",
    "dialog:allow-open",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://**/v1/*" },
        { "url": "https://**/v1/*" },
        { "url": "http://127.0.0.1:1234/v1/*" },
        { "url": "http://localhost:1234/v1/*" }
      ]
    }
  ]
}
