{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Workshop",
  "version": "0.1.0",
  "identifier": "com.workshop.localplatform",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "capabilities": ["default"],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1234 http://localhost:1234; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self' blob: 'sha256-1lMgAEGlMecH2FqS/rdFgmIx2cK5Zr+vDZrdy4alWd4='; frame-src 'self' blob:"
    },
    "windows": [
      {
        "title": "Workshop",
        "width": 1440,
        "height": 920,
        "minWidth": 700,
        "minHeight": 520,
        "center": true,
        "resizable": true
      }
    ]
  },
  "plugins": {
    "http": {
      "scopeRedirects": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "packaging-icons/32x32.png",
      "packaging-icons/128x128.png",
      "packaging-icons/128x128@2x.png",
      "packaging-icons/icon.icns",
      "packaging-icons/icon.ico"
    ]
  }
}
